// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  // output   = "../src/generated/prisma/client"
}

datasource db {
  provider = "postgresql"
}

// --- Enums ---

enum UserRole {
  USER // Public user: can browse and register for games
  MEMBER // Club Member: can reserve tables
  ADMIN // Admin: can manage tables and users
}

enum RegistrationStatus {
  PENDING
  CONFIRMED
  WAITLIST
  CANCELLED
}

// --- NextAuth.js Models ---

/// Represents a user of the system, including their role and associated data.
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          UserRole  @default(USER)
  accounts      Account[]
  sessions      Session[]

  // Application Relations
  reservations  Reservation[]      @relation("ReservedBy")
  registrations GameRegistration[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Stores authentication account details for third-party providers.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  // Optional: Add Discord specific fields if you need them later
  // discord_id    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

/// Represents an active user session for authentication.
model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Stores tokens used for email verification and sign-in.
model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// --- RPG Club Domain Models ---

/// A physical table in the club that can be reserved.
model Table {
  id           String        @id @default(cuid())
  name         String // e.g., "Table 1 (Window)", "War Room"
  capacity     Int           @default(6)
  reservations Reservation[]
}

/// A booking of a physical table by a user (typically a Member or DM).
model Reservation {
  id        String   @id @default(cuid())
  title     String // Internal name e.g. "Bob's Campaign"
  startTime DateTime
  endTime   DateTime

  // Relations
  tableId String
  table   Table  @relation(fields: [tableId], references: [id])

  userId String
  user   User   @relation("ReservedBy", fields: [userId], references: [id])

  // Optional: If this reservation is a public game, it has a GameSession attached
  gameSession GameSession?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startTime, endTime])
}

/// Public-facing details for a game scheduled at a reserved table.
model GameSession {
  id          String  @id @default(cuid())
  title       String // Public title e.g. "Curse of Strahd: Session 1"
  description String? @db.Text
  system      String // e.g. "D&D 5e", "Pathfinder 2e"
  image       String? // URL to a cover image
  minPlayers  Int     @default(3)
  maxPlayers  Int     @default(5)

  // Link to the physical reservation
  reservationId String      @unique
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  registrations GameRegistration[]
}

/// A registration entry for a user signing up to play in a specific game session.
model GameRegistration {
  id String @id @default(cuid())

  gameSessionId String
  gameSession   GameSession @relation(fields: [gameSessionId], references: [id], onDelete: Cascade)

  // Link to a registered user
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Or allow guest info if you want public signups without full accounts (optional)
  // guestName    String?
  // guestContact String?

  status RegistrationStatus @default(PENDING)
  note   String? // "I'm bringing a cleric"

  createdAt DateTime @default(now())

  @@unique([gameSessionId, userId]) // Prevent double signup
}
